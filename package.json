{
  "name": "@local/literature-reader",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Gloss: a PDF-first research reader with contextual translation, chapter explanations, research conversations and source-linked references.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/pdf.min.js",
    "vendor/pdf.worker.min.js",
    "vendor/LICENSE",
    "vendor/structure.py",
    "vendor/chapter-reader.js",
    "vendor/research-ideas.js",
    "vendor/citation-nav.js",
    "vendor/paper-context.js",
    "vendor/chapter-context.js",
    "vendor/library-resolver.js",
    "vendor/gloss-math/**",
    "docs/*.md",
    "docs/assets/*",
    "requirements.txt",
    "setup.mjs"
  ],
  "gloss": {
    "setup": {
      "guide": "./README.md",
      "requirements": "./requirements.txt",
      "check": ["node", "setup.mjs", "--check"],
      "install": ["node", "setup.mjs", "--install"]
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "export:source": "node scripts/export-source.mjs"
  }
}
